# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Allowed Origins (comma separated list of allowed URLs)
# Add your frontend web domain(s) or development origins here
CORS_ORIGIN=http://127.0.0.1:3000,http://127.0.0.1:3001

# Client & Admin URLs for redirects/webhooks
CLIENT_URL=http://127.0.0.1:3000
ADMIN_URL=http://127.0.0.1:3001
